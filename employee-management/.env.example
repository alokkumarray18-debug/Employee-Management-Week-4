# Copy to .env (or export these) before running with the "local" profile.
# Never commit a real .env file - it's already covered by .gitignore below.

LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_local_mysql_password

# Only needed if you actually run the dev/qa profiles locally
# DEV_DB_PASSWORD=dev_password
# QA_DB_PASSWORD=qa_password

# Only needed for docker-compose (defaults already match docker-compose.yml)
# MYSQL_USER=employee_user
# MYSQL_PASSWORD=employee_pass
